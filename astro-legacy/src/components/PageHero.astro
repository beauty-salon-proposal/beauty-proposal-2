---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="container section" style="padding-bottom:0">
  <p class="eyebrow reveal">{eyebrow}</p>
  <h1 class="reveal">{title}</h1>
  {intro && <p class="lede reveal">{intro}</p>}
  <div class="reveal"><slot /></div>
</section>
